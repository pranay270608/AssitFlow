class BinaryTree:
    index =-1
    @classmethod
    def build_tree(cls,nodes):
        cls.index +=1
        if nodes[cls.index]== -1:
            return None
        new_node =Node(nodes[cls.index])
        new_node.left=cls.build_tree(nodes)
        new_node.right=cls.build_tree(nodes)
        return new_node
    @classmethod
    def preorder(cls,root):
        if root is None:
            return
        print(root.data)
        cls.preorder(root.left)
        cls.preorder(root.right)
    @classmethod
    def postorder(cls,root):
        if root is None:
            return
        cls.postorder(root.left)
        cls.postorder(root.right)
        print(root.data)
    @classmethod
    def inorder(cls,root):
        if root is None:
            return
        cls.inorder(root.left)
        print(root.data)
        cls.inorder(root.right)
    @classmethod
    def bfs(cls,root):
        if root is None:
            return
        queue = deque([root])
        while queue:
            node = queue.popleft()
            print(node.data,end="")
            if node.left:
                queue.append(node.left)
            if node.right:
