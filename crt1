class stack:
    def __init__(self):
        self.items=[]
    def append(self,items):
        self.items.append(items)
    def pop(self):
        if len(self.items)==0:
            return "under flow"
        return self.items.pop()
    def peek(self):
        return self.items[-1]
    def isEmpty(self):
        if len(self.items)==0:
          return True
        return False
    def display(self):
        if self.isEmpty():
       
         return "stack empty"
        else:
         return self.items
